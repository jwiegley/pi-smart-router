{
  "name": "pi-smart-router",
  "version": "1.4.0-jw.5",
  "description": "Pi virtual models smart-router/auto and smart-router/local, routed by a per-host roster",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "routing",
    "virtual-model"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwiegley/pi-smart-router.git"
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs",
    "pack:check": "npm pack --dry-run --json --ignore-scripts | node test/pack-check.mjs",
    "check": "tsc --noEmit && node test/run.mjs && npm run pack:check",
    "check:sandbox": "tsc --noEmit && node test/sandbox.mjs && npm run pack:check"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
